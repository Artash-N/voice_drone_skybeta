# copy this to .env or export them in your shell

export OPENAI_API_KEY="your_key_here"
export OPENAI_BASE_URL="https://api.openai.com/v1"
export OPENAI_INTENT_MODEL="gpt-4.1"
export OPENAI_TRANSCRIBE_MODEL="gpt-4o-mini-transcribe"

# pick the px4_msgs branch that matches your px4 firmware
# examples: main, release/1.15, release/1.14
export PX4_MSGS_BRANCH="release/1.15"

# if you use a namespace on the px4 side, keep the same one here
# examples: "", "uav_1", "drone"
export PX4_TOPIC_NS=""

# change this if you want to use a different yolo model
export YOLO_MODEL="yolov8n.pt"
